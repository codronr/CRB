<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <title>Tarifs – CRB Coaching Bricolage &amp; Rénovation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tarifs clairs et transparents pour les services de coaching bricolage et rénovation CRB.">
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="brand"> <img src="logo-crb.png" alt="CRB" class="brand-logo"
            style="width: 100px; height: 100px;"> <span class="brand-name">CRB
            Coaching Bricolage &amp; Rénovation</span> </div>
        <nav class="main-nav"> <a href="index.html" class="nav-link">Accueil</a>
          <a href="services.html" class="nav-link">Services</a> <a href="tarifs.html"
            class="nav-link">Tarifs</a> <a href="realisations.html" class="nav-link">Réalisations</a>
          <a href="contact.html" class="nav-cta">Contact</a> </nav>
      </div>
    </header>
    <section class="hero">
      <div class="container">
        <h1>Nos tarifs</h1>
        <p>Des formules simples, sans engagement, adaptées à vos besoins</p>
      </div>
    </section>
    <section class="services">
      <div class="container">
        <h2>Nos tarifs</h2>
        <div class="tarifs-grid">
          <div class="card price-card"> <img src="outils.png" class="outil-anim"
              alt="Outils">
            <h3>Coaching 3 heures</h3>
            <p class="price">115 €</p>
            <p>Idéal pour un petit projet ou un besoin ponctuel.</p>
            <a href="https://buy.stripe.com/xxxx" class="btn">Réserver</a> </div>
          <div class="card price-card highlight"> <img src="maison.png" alt="Maison - Projet rénovation"
              class="outil-anim">
            <h3>Coaching 5 heures</h3>
            <p class="price">180 €</p>
            <p>Le meilleur choix pour un projet de rénovation.</p>
            <a href="https://buy.stripe.com/xxxx" class="btn">Réserver</a> </div>
          <div class="card price-card"> <img src="renovation-interieur.png" alt="Rénovation intérieure avant après"
              class="outil-anim">&nbsp;
            <h3>Coaching 10 heures</h3>
            <p class="price">350 €</p>
            <p>Un accompagnement complet et sécurisé.</p>
            <a href="https://buy.stripe.com/xxxx" class="btn">Réserver</a> </div>
        </div>
      </div>
    </section>
    <section class="about">
      <div class="container">
        <h2>Ce qui est inclus</h2>
        <ul class="points">
          <li>✔ Diagnostic de votre projet</li>
          <li>✔ Conseils techniques personnalisés</li>
          <li>✔ Méthodes professionnelles</li>
          <li>✔ Accompagnement sécurisé</li>
        </ul>
      </div>
    </section>
    <section class="contact">
      <div class="container">
        <h2>Besoin d'un devis personnalisé ?</h2>
        <p>Contactez-nous pour une étude adaptée à votre projet.</p>
        <p><strong>Téléphone :</strong> 06 46 43 57 53</p>
        <p><strong>Email :</strong> contact@crb.fr</p>
      </div>
    </section>
    <footer class="footer">
      <div class="container">
        <p>© 2026 CRB – Coaching Bricolage &amp; Rénovation CODRON romuald</p>
      </div>
    </footer>
  </body>
</html>
