<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <title>CRB – Coaching Bricolage &amp; Rénovation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CRB – Coaching, accompagnement et conseils en bricolage et rénovation pour particuliers.">
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="brand">
          <img src="logo-crb.png" alt="CRB" class="brand-logo" style="width: 100px; height: 100px; color: white;">
          <span class="brand-name">CRB Coaching Bricolage &amp; Rénovation</span>
        </div>
        <nav class="main-nav">
          <a href="index.html" class="nav-link">Accueil</a>
          <a href="services.html" class="nav-link">Services</a>
          <a href="tarifs.html" class="nav-link">Tarifs</a>
          <a href="realisations.html" class="nav-link">Réalisations</a>
          <a href="contact.html" class="nav-cta">Contact</a>
        </nav>
      </div>
    </header>
    <section class="hero">
      <div class="container">
        <h1>Votre expert en bricolage &amp; rénovation</h1>
        <p>Un accompagnement professionnel pour réussir vos travaux, sans stress</p>
        <a href="services.html" class="btn">Voir nos services</a> </div>
    </section>
    <section class="services">
      <div class="container">
        <h2>Nos services</h2>
        <div class="grid">
          <div class="card"> <img src="images/conseil.jpg" alt="Conseil travaux">
            <h3>Conseil &amp; diagnostic</h3>
            <p>Analyse de vos besoins et solutions adaptées à votre budget.</p>
          </div>
          <div class="card"> <img src="images/accompagnement.jpg" alt="Accompagnement">
            <h3>Accompagnement chantier</h3>
            <p>Un expert à vos côtés à chaque étape de vos travaux.</p>
          </div>
          <div class="card"> <img src="images/formation.jpg" alt="Formation bricolage">
            <h3>Coaching bricolage</h3>
            <p>Apprenez à faire vous-même avec les bonnes méthodes.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="realisations">
      <div class="container">
        <h2>Nos réalisations</h2>
        <div class="gallery"> <img src="images/realisation1.jpg" alt="Rénovation salle de bain">
          <img src="images/realisation2.jpg" alt="Cuisine rénovée"> <img src="images/realisation3.jpg"
            alt="Peinture intérieure"> </div>
      </div>
    </section>
    <section class="about">
      <div class="container">
        <h2>Pourquoi choisir CRB ?</h2>
        <ul class="points">
          <li>✔ Expertise professionnelle</li>
          <li>✔ Conseils clairs et honnêtes</li>
          <li>✔ Gain de temps et d'argent</li>
          <li>✔ Accompagnement personnalisé</li>
        </ul>
      </div>
    </section>
    <section class="contact" id="contact">
      <div class="container">
        <h2>Contact</h2>
        <p>Besoin d'un conseil ou d'un devis ?</p>
        <p><strong>Téléphone :</strong> 06 46 43 57 53</p>
        <p><strong>Email :</strong> contact@crb.fr</p>
      </div>
    </section>
    <footer class="footer">
      <div class="container">
        <p>© 2026 CRB – Coaching Bricolage &amp; Rénovation CODRON romuald</p>
      </div>
    </footer>
  </body>
</html>
