<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8">
    <title>Contact – CRB Coaching Bricolage &amp; Rénovation</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Contactez CRB pour vos projets de bricolage et rénovation.">
    <link rel="stylesheet" href="style.css">
  </head>
  <body>
    <!-- ===== BANNIÈRE / MENU ===== -->
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="brand"> <img src="logo-crb.png" alt="CRB" class="brand-logo"
            style="width: 100px; height: 100px;"> <span class="brand-name">CRB
            Coaching Bricolage &amp; Rénovation</span> </div>
        <nav class="main-nav"> <a href="index.html" class="nav-link">Accueil</a>
          <a href="services.html" class="nav-link">Services</a> <a href="tarifs.html"
            class="nav-link">Tarifs</a> <a href="realisations.html" class="nav-link">Réalisations</a>
          <a href="contact.html" class="nav-cta">Contact</a> </nav>
      </div>
    </header>
    <!-- ===== HERO ===== -->
    <section class="hero">
      <div class="container">
        <h1>Contactez-nous</h1>
        <p>Présentez-nous votre projet, nous vous répondrons rapidement</p>
      </div>
    </section>
    <!-- ===== FORMULAIRE (VERTICAL) ===== -->
    <section class="contact">
      <div class="container">
        <h2>Envoyer un message</h2>
        <form method="post" action="contact.php" class="contact-form"> <input name="nom"
            placeholder="Votre nom" required="" type="text"> <input name="email"
            placeholder="Votre email" required="" type="email"> <input name="sujet"
            placeholder="Sujet" required="" type="text"> <textarea name="message"
placeholder="Votre message" rows="6" required=""></textarea> <button type="submit"
            class="btn">Envoyer le message</button> </form>
        <div class="contact-infos">
          <p>📞 <strong>Téléphone :</strong> 06 46 43 57 53 </p>
          <p>📧 <strong>Email :</strong> contact@crb.fr</p>
        </div>
      </div>
    </section>
    <!-- ===== FOOTER ===== -->
    <footer>
      <p>© 2026 CRB – Coaching Bricolage &amp; Rénovation</p>
    </footer>
  </body>
</html>
